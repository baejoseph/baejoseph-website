---
// FloatingThemedEmblem.astro — The Spirit moves through the words.
// Powered by @chenglou/pretext for real-time obstacle-aware text layout.
//
// Pretext loaded via dynamic import at runtime. The library is ~10KB gzipped
// and only loads on pages with article prose (not on index/tag listing pages).
---

<div id="emblem-root"></div>

<script is:inline>
(function () {
  'use strict';

  var EMOJIS = [
    '\u271D\uFE0F',              // Cross
    '\uD83D\uDD4A\uFE0F',       // Dove
    '\uD83C\uDDEC\uD83C\uDDE7', // UK
    '\uD83C\uDDFA\uD83C\uDDF8', // USA
    '\uD83C\uDDF0\uD83C\uDDF7', // Korea
  ];

  var GLOW = {
    '\u271D\uFE0F':       'rgba(218,167,65,0.6)',
    '\uD83D\uDD4A\uFE0F': 'rgba(140,180,240,0.6)',
    '\uD83C\uDDEC\uD83C\uDDE7': 'rgba(200,60,70,0.5)',
    '\uD83C\uDDFA\uD83C\uDDF8': 'rgba(80,120,200,0.5)',
    '\uD83C\uDDF0\uD83C\uDDF7': 'rgba(150,160,200,0.5)',
  };

  var SIZE = 64;
  var OBSTACLE_R = 52;
  var LINE_H = 30;
  var PARA_GAP = 32;
  var MIN_SLOT = 40;
  var LERP = 0.15;
  var STORAGE = 'baejoseph_emblem_v2';
  var PRETEXT_CDN = 'https://esm.sh/@chenglou/pretext@0.0.6';

  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var prose = document.querySelector('.prose');
  if (!prose) return;

  var isKo = prose.classList.contains('lang-ko');
  var fontStr = isKo ? '17px "Noto Sans KR", sans-serif' : '17px "Inter", -apple-system, BlinkMacSystemFont, sans-serif';

  (async function () {
    var pt;
    try { pt = await import(PRETEXT_CDN); } catch { return; }

    var prepareWithSegments = pt.prepareWithSegments;
    var layoutNextLine = pt.layoutNextLine;

    // ── Prepare text with Pretext ──────────────────────────────────
    var rawText = prose.innerText || prose.textContent || '';
    var rawParagraphs = rawText.split(/\n\n+/);
    var preparedParagraphs = [];

    for (var i = 0; i < rawParagraphs.length; i++) {
      var text = rawParagraphs[i].trim();
      if (!text) continue;
      var prepared = prepareWithSegments(text, fontStr, { wordBreak: isKo ? 'keep-all' : 'normal' });
      preparedParagraphs.push({ prepared: prepared, cursor: { segmentIndex: 0, graphemeIndex: 0 } });
    }
    if (!preparedParagraphs.length) return;

    // ── Pick emoji ─────────────────────────────────────────────────
    var emoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
    var glowColor = GLOW[emoji] || 'rgba(180,180,220,0.5)';
    var glowSoft = glowColor.replace(/[\d.]+\)$/, '0.3)');
    var glowFaint = glowColor.replace(/[\d.]+\)$/, '0.15)');

    // ── Toggle ─────────────────────────────────────────────────────
    var stored = localStorage.getItem(STORAGE);
    var enabled = stored === null ? (prefersReducedMotion ? false : true) : stored === 'true';
    var currentMode = 'reflow';

    // ── DOM ────────────────────────────────────────────────────────
    var stage = document.createElement('div');
    stage.className = 'emblem-stage';

    var emblemEl = document.createElement('div');
    emblemEl.className = 'floating-emblem';
    emblemEl.textContent = emoji;
    emblemEl.style.fontSize = SIZE + 'px';
    emblemEl.style.filter =
      'drop-shadow(0 0 12px ' + glowColor + ')' +
      'drop-shadow(0 0 32px ' + glowSoft + ')' +
      'drop-shadow(0 0 64px ' + glowFaint + ')';
    stage.appendChild(emblemEl);

    var linePool = [];
    var targetX = window.innerWidth / 2;
    var targetY = window.innerHeight / 2;
    var smoothX = targetX, smoothY = targetY;

    document.addEventListener('mousemove', function (e) { targetX = e.clientX; targetY = e.clientY; }, { passive: true });
    document.addEventListener('touchmove', function (e) { if (e.touches.length) { targetX = e.touches[0].clientX; targetY = e.touches[0].clientY; } }, { passive: true });
    document.addEventListener('touchstart', function (e) { if (e.touches.length) { targetX = e.touches[0].clientX; targetY = e.touches[0].clientY; } }, { passive: true });

    function syncStage() {
      var rect = prose.getBoundingClientRect();
      stage.style.position = 'absolute';
      stage.style.left = rect.left + 'px';
      stage.style.top = (rect.top + window.scrollY) + 'px';
      stage.style.width = rect.width + 'px';
      stage.style.height = rect.height + 'px';
    }

    // ── Obstacle math (editorial engine pattern) ───────────────────
    function circleInterval(cx, cy, r, bandTop, bandBottom) {
      var vTop = bandTop - 2, vBot = bandBottom + 2;
      if (vTop >= cy + r || vBot <= cy - r) return null;
      var minDy = cy >= bandTop && cy <= bandBottom ? 0 : cy < bandTop ? bandTop - cy : cy - bandBottom;
      if (minDy >= r) return null;
      var maxDx = Math.sqrt(r * r - minDy * minDy);
      return { left: cx - maxDx, right: cx + maxDx };
    }

    function carveSlots(base, blocked) {
      var slots = [base];
      for (var bi = 0; bi < blocked.length; bi++) {
        var b = blocked[bi];
        var next = [];
        for (var si = 0; si < slots.length; si++) {
          var s = slots[si];
          if (b.right <= s.left || b.left >= s.right) { next.push(s); continue; }
          if (b.left > s.left) next.push({ left: s.left, right: b.left });
          if (b.right < s.right) next.push({ left: b.right, right: s.right });
        }
        slots = next;
      }
      return slots.filter(function (s) { return s.right - s.left >= MIN_SLOT; });
    }

    // ── Layout engine ──────────────────────────────────────────────
    function layoutAll(cx, cy, pLeft, pW, pTop, pBottom) {
      var lines = [];
      var y = pTop;
      var pi = 0;

      while (y + LINE_H <= pBottom && pi < preparedParagraphs.length) {
        var para = preparedParagraphs[pi];
        var line = layoutNextLine(para.prepared, para.cursor, pW);

        if (!line) { pi++; if (pi < preparedParagraphs.length) y += PARA_GAP; continue; }

        var bandTop = y, bandBottom = y + LINE_H;
        var interval = circleInterval(cx, cy, OBSTACLE_R, bandTop, bandBottom);
        var blocked = interval ? [interval] : [];
        var slots = carveSlots({ left: pLeft, right: pLeft + pW }, blocked);

        if (!slots.length) { para.cursor = line.end; y += LINE_H; continue; }

        var slot = slots[0];
        lines.push({ x: Math.round(slot.left), y: Math.round(y), text: line.text });
        para.cursor = line.end;
        y += LINE_H;
      }

      return lines;
    }

    // ── Render loop ────────────────────────────────────────────────
    var rafId = null;

    function render() {
      smoothX += (targetX - smoothX) * LERP;
      smoothY += (targetY - smoothY) * LERP;

      var bounce = 1 + 0.025 * Math.sin(Date.now() / 400);
      emblemEl.style.transform = 'translate(' + (smoothX - SIZE / 2) + 'px,' + (smoothY - SIZE / 2 + window.scrollY) + 'px) scale(' + bounce + ')';

      if (currentMode === 'reflow') {
        var rect = prose.getBoundingClientRect();
        var lines = layoutAll(smoothX, smoothY + window.scrollY, rect.left, rect.width, rect.top + window.scrollY, rect.top + window.scrollY + rect.height);

        while (linePool.length < lines.length) {
          var span = document.createElement('span');
          span.className = 'emblem-line';
          span.style.font = fontStr;
          span.style.lineHeight = LINE_H + 'px';
          span.style.color = 'var(--text, #e8e8e8)';
          stage.appendChild(span);
          linePool.push(span);
        }

        for (var i = 0; i < linePool.length; i++) {
          if (i < lines.length) {
            var l = lines[i];
            linePool[i].textContent = l.text;
            linePool[i].style.left = l.x + 'px';
            linePool[i].style.top = l.y + 'px';
            linePool[i].style.display = '';
          } else { linePool[i].style.display = 'none'; }
        }
      }

      rafId = requestAnimationFrame(render);
    }

    // ── Toggle button ──────────────────────────────────────────────
    var header = document.querySelector('header .inner');
    if (!header) return;

    var toggle = document.createElement('button');
    toggle.id = 'emblem-toggle';
    toggle.className = 'emblem-toggle-btn';

    function updateToggleUI() {
      if (!enabled) {
        toggle.textContent = '\u2728';
        toggle.setAttribute('aria-label', 'Enable floating emblem');
      } else if (currentMode === 'reflow') {
        toggle.textContent = '\u2600\uFE0F';
        toggle.setAttribute('aria-label', 'Switch to overlay mode');
      } else {
        toggle.textContent = '\uD83C\uDFFC\uFE0F';
        toggle.setAttribute('aria-label', 'Switch to reflow mode');
      }
    }
    updateToggleUI();

    var nav = header.querySelector('nav');
    if (nav) header.insertBefore(toggle, nav);
    else header.appendChild(toggle);

    toggle.addEventListener('click', function () {
      if (!enabled) {
        enabled = true; currentMode = 'reflow';
        prose.style.visibility = 'hidden';
        document.body.appendChild(stage); syncStage();
        for (var pi = 0; pi < preparedParagraphs.length; pi++) preparedParagraphs[pi].cursor = { segmentIndex: 0, graphemeIndex: 0 };
        rafId = requestAnimationFrame(render);
      } else if (currentMode === 'reflow') {
        currentMode = 'overlay';
        prose.style.visibility = '';
        for (var li = 0; li < linePool.length; li++) linePool[li].style.display = 'none';
      } else {
        enabled = false; currentMode = 'reflow';
        prose.style.visibility = '';
        stage.remove();
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
      localStorage.setItem(STORAGE, enabled ? 'true' : 'false');
      updateToggleUI();
    });

    // ── Resize / scroll ────────────────────────────────────────────
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(function () { if (enabled) syncStage(); }).observe(prose);
    }
    window.addEventListener('resize', function () { if (enabled) syncStage(); });
    window.addEventListener('scroll', function () { if (enabled) syncStage(); }, { passive: true });

    // ── Init ───────────────────────────────────────────────────────
    if (enabled) {
      if (currentMode === 'reflow') prose.style.visibility = 'hidden';
      document.body.appendChild(stage);
      syncStage();
      rafId = requestAnimationFrame(render);
    }
  })();
})();
</script>

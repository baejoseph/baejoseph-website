---
/**
 * Dark/light switch. The icon shows the theme you are currently in — moon while
 * dark, sun while light — and the choice is remembered in localStorage, so it
 * follows the reader around the site and survives a closed tab.
 */
interface Props {
  /** Pin to the top right, for the standalone token pages. */
  floating?: boolean;
}
const { floating = false } = Astro.props;
---
<button
  type="button"
  id="theme-toggle"
  class:list={['theme-toggle', floating && 'floating']}
  title="Switch between dark and light"
  aria-label="Switch between dark and light mode"
>
  <span class="tt-moon" aria-hidden="true">☾</span>
  <span class="tt-sun" aria-hidden="true">☀</span>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      if (next === 'dark') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', next);
      try { localStorage.setItem('baejoseph_theme', next); } catch (err) { /* private mode */ }
    });
  })();
</script>

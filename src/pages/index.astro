---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SignupForm from '../components/SignupForm.astro';

const allPosts = await getCollection('blog');

// Build-time today string for marking future posts
const buildDate = new Date().toISOString().slice(0, 10); // 'YYYY-MM-DD'

// Collect all tags sorted by frequency (from ALL posts — future posts have tags too)
const tagCount = new Map<string, number>();
allPosts.forEach(p => p.data.tags?.forEach(t => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)));
const allTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);

const posts = allPosts.sort((a, b) => {
  const da = a.data.date ?? '1970-01-01';
  const db = b.data.date ?? '1970-01-01';
  const dateCmp = db.localeCompare(da);
  if (dateCmp !== 0) return dateCmp;
  // Same date: EN before KO
  const la = a.data.lang ?? 'en';
  const lb = b.data.lang ?? 'en';
  if (la === lb) return 0;
  return la === 'en' ? -1 : 1;
});

function formatDate(d?: string) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

// Use the WP slug as href — already lowercase percent-encoded, so browser sends exact bytes
// matching the dist/%ec.../index.html files directly (no case mismatch)
function postHref(post: typeof posts[0]) {
  const wpSlug = post.data.wpSlug ?? post.slug;
  return '/' + wpSlug + '/';
}

function cardTitle(title: string) {
  return title
    .replace(/\u201c/g, '"')
    .replace(/\u201d/g, '"')
    .replace(/\u2018/g, "'")
    .replace(/\u2019/g, "'");
}

function toCard(post: typeof posts[0], label: string) {
  return {
    src:   (post.data.featuredImage as string) || '/assets/intro.jpg',
    href:  postHref(post),
    title: cardTitle(post.data.title as string),
    label,
  };
}

const introEnPost = posts.find(p => p.slug === 'intro');
const introKoPost = posts.find(p => p.slug === '소개');

const introEn = introEnPost
  ? toCard(introEnPost, 'Intro')
  : { src: '/assets/intro.jpg', href: '/intro/', title: 'Who Is Joseph Bae?', label: 'Intro' };

const introKo = introKoPost
  ? toCard(introKoPost, '소개')
  : { ...introEn, href: '/소개/', title: '조셉 배는 누구인가', label: '소개' };

// Featured pool: EN posts only, non-future, must have a featuredImage.
// Exclude the intro pair so Featured is never the same card as Intro.
const heroPool = posts
  .filter(p =>
    p.data.featuredImage &&
    (p.data.lang ?? 'en') === 'en' &&
    (p.data.date ?? '1970-01-01') <= buildDate &&
    p.slug !== 'intro' &&
    p.slug !== '소개'
  )
  .map(p => ({
    src:   p.data.featuredImage as string,
    href:  postHref(p),
    title: cardTitle(p.data.title as string),
    label: 'Featured',
  }));
---

<Layout title="Joseph Bae" description="Faith · Culture · Life — by Joseph Bae.">
  <!-- Hero carousel: Intro (default) → Featured (random). Signup card comes later. -->
  <div
    class="home-hero"
    id="home-hero"
    tabindex="0"
    style={`background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.58)), url('${introEn.src}')`}
  >
    <button type="button" class="hero-nav hero-nav-prev" id="hero-prev" aria-label="Previous card">‹</button>
    <a class="hero-link" id="hero-link" href={introEn.href} aria-label={introEn.title}>
      <div class="hero-text">
        <h1>A Personal Blog</h1>
        <p>Faith · Culture · Life · Maranatha 🕦️</p>
      </div>
      <div class="hero-featured">
        <span class="hero-featured-label" id="hero-label">{introEn.label}</span>
        <span class="hero-featured-title" id="hero-featured-title">{introEn.title}</span>
      </div>
    </a>
    <div class="hero-signup" id="hero-signup" hidden>
      <div class="hero-text">
        <h1 id="signup-h1">A letter, not a feed</h1>
        <p id="signup-p">New post on Fridays. One from the archive on Tuesdays.</p>
      </div>
      <div class="hero-signup-form">
        <SignupForm source="home_hero" lang="en" compact />
      </div>
    </div>
    <div class="hero-dots" id="hero-dots" role="tablist" aria-label="Hero cards"></div>
    <button type="button" class="hero-nav hero-nav-next" id="hero-next" aria-label="Next card">›</button>
  </div>

  <div class="lang-filter">
    <button class="lang-btn" onclick="filterLang('all',this)">All</button>
    <button class="lang-btn active" onclick="filterLang('en',this)">English</button>
    <button class="lang-btn" onclick="filterLang('ko',this)">한국어</button>
  </div>

  {allTags.length > 0 && (
    <div class="tag-browse" id="tag-browse">
      {allTags.map((tag, i) => (
        <a href={`/tag/${tag}`} class="tag-pill-sm" data-tag-index={i} class:list={i >= 6 ? ['tag-hidden'] : []}>#{tag}</a>
      ))}
      {allTags.length > 6 && (
        <button class="tag-expand" id="tag-expand-btn" onclick="toggleTags(this)">Show all {allTags.length} tags</button>
      )}
    </div>
  )}

  <div class="post-list" id="post-list">
    {posts.map(post => {
      // Future-dated: in the HTML for anyone with the URL, hidden from the
      // public list, shown on this machine when signed in (bae_admin_ui).
      const isFuture = (post.data.date ?? '1970-01-01') > buildDate;
      return (
        <a
          href={postHref(post)}
          class="post-item"
          data-lang={post.data.lang ?? 'en'}
          data-future={isFuture ? 'true' : 'false'}
          style={isFuture ? 'display:none' : undefined}
        >
          <span class="post-date">{formatDate(post.data.date)}</span>
          <span class="post-title">{post.data.title}</span>
          <span class="post-lang-badge">{(post.data.lang ?? 'en').toUpperCase()}</span>
        </a>
      );
    })}
  </div>
</Layout>

<script define:vars={{ heroPool, introEn, introKo }}>
  // ── Hero carousel: Intro (0) → Featured (1). Signup will be (2). ──────────
  const HERO_OVERLAY = 'linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.58))';
  const featuredPick = (heroPool && heroPool.length > 0)
    ? heroPool[Math.floor(Math.random() * heroPool.length)]
    : null;

  let heroIndex = 0;
  let heroGen = 0;

  function heroSlides(lang) {
    const intro = lang === 'ko' ? introKo : introEn;
    const slides = [intro];
    if (featuredPick) {
      slides.push({
        ...featuredPick,
        kind: 'featured',
        label: lang === 'ko' ? '추천' : 'Featured',
      });
    }
    slides.push({
      kind: 'signup',
      src: intro.src,
      href: '#signup',
      title: lang === 'ko' ? '금요일의 편지' : 'A letter, not a feed',
      label: lang === 'ko' ? '구독' : 'Newsletter',
    });
    return slides;
  }

  function renderHeroDots(slides, index) {
    const dots = document.getElementById('hero-dots');
    if (!dots) return;
    const existing = dots.querySelectorAll('.hero-dot');
    if (existing.length === slides.length) {
      existing.forEach((btn, i) => {
        btn.classList.toggle('is-active', i === index);
        btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
      return;
    }
    dots.replaceChildren();
    slides.forEach((_, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'hero-dot' + (i === index ? ' is-active' : '');
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', i === index ? 'true' : 'false');
      btn.setAttribute('aria-label', `Hero card ${i + 1} of ${slides.length}`);
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        heroIndex = i;
        renderHero();
      });
      dots.appendChild(btn);
    });
  }

  function renderHero() {
    const slides = heroSlides(activeLang);
    if (slides.length === 0) return;
    if (heroIndex >= slides.length) heroIndex = 0;
    const index = heroIndex;
    const slide = slides[index];
    const gen = ++heroGen;
    renderHeroDots(slides, index);
    const hero = document.getElementById('home-hero');
    const link = document.getElementById('hero-link');
    const titleEl = document.getElementById('hero-featured-title');
    const labelEl = document.getElementById('hero-label');

    const apply = () => {
      if (gen !== heroGen) return;
      const signup = document.getElementById('hero-signup');
      const isSignup = slide.kind === 'signup';
      if (hero) {
        hero.style.backgroundImage = `${HERO_OVERLAY}, url('${slide.src}')`;
      }
      if (link) {
        link.hidden = isSignup;
        if (!isSignup) {
          link.setAttribute('href', slide.href);
          link.setAttribute('aria-label', slide.title);
        }
      }
      if (signup) signup.hidden = !isSignup;
      if (isSignup) {
        const h1 = document.getElementById('signup-h1');
        const p = document.getElementById('signup-p');
        if (h1) h1.textContent = activeLang === 'ko' ? '피드가 아니라 편지' : 'A letter, not a feed';
        if (p) p.textContent = activeLang === 'ko'
          ? '금요일에 새 글. 화요일에 지난 글.'
          : 'New post on Fridays. One from the archive on Tuesdays.';
        const form = signup?.querySelector('form[data-signup]');
        if (form) form.setAttribute('data-lang', activeLang === 'ko' ? 'ko' : 'en');
      }
      if (titleEl) titleEl.textContent = slide.title;
      if (labelEl) labelEl.textContent = slide.label;
    };

    if (!slide.src) {
      apply();
      return;
    }
    const img = new Image();
    img.onload = apply;
    img.onerror = apply;
    img.src = slide.src;
  }

  function stepHero(delta) {
    const slides = heroSlides(activeLang);
    if (slides.length < 2) return;
    heroIndex = (heroIndex + delta + slides.length) % slides.length;
    renderHero();
  }

  document.getElementById('hero-prev')?.addEventListener('click', (e) => {
    e.preventDefault();
    stepHero(-1);
  });
  document.getElementById('hero-next')?.addEventListener('click', (e) => {
    e.preventDefault();
    stepHero(1);
  });
  document.getElementById('home-hero')?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); stepHero(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); stepHero(1); }
  });

  // ── Tag expand/collapse ──────────────────────────────────────────────────
  function toggleTags(btn) {
    const hidden = document.querySelectorAll('#tag-browse .tag-hidden');
    const isExpanded = btn.dataset.expanded === 'true';
    if (isExpanded) {
      hidden.forEach(el => el.classList.remove('tag-revealed'));
      btn.textContent = btn.dataset.originalText;
      btn.dataset.expanded = 'false';
    } else {
      hidden.forEach(el => el.classList.add('tag-revealed'));
      btn.dataset.originalText = btn.textContent;
      btn.textContent = 'Show less';
      btn.dataset.expanded = 'true';
    }
  }
  window.toggleTags = toggleTags;

  // ── Lang / preview filter ─────────────────────────────────────────────────
  const STORAGE_KEY = 'baejoseph_preview_mode';
  const LANG_SESSION_KEY = 'baejoseph_lang_filter';
  let activeLang = 'en';

  function isPreview() {
    try {
      if (document.cookie.split(';').some(c => c.trim().startsWith('bae_admin_ui=1'))) return true;
    } catch {}
    try { return localStorage.getItem(STORAGE_KEY) === 'true'; } catch { return false; }
  }

  function updatePostVisibility() {
    const preview = isPreview();
    document.querySelectorAll('.post-item').forEach(el => {
      const langMatch = activeLang === 'all' || el.dataset.lang === activeLang;
      const isFuture = el.dataset.future === 'true';
      el.style.display = langMatch && (!isFuture || preview) ? 'flex' : 'none';
    });
  }

  function filterLang(lang, btn) {
    document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeLang = lang;
    try { sessionStorage.setItem(LANG_SESSION_KEY, lang); } catch {}
    updatePostVisibility();
    renderHero();
  }
  window.filterLang = filterLang;

  // ── Restore from URL or sessionStorage on load ────────────────────────────
  function getInitialLang() {
    const params = new URLSearchParams(window.location.search);
    const urlLang = params.get('lang');
    if (urlLang === 'en' || urlLang === 'ko') return urlLang;
    try {
      const sessionLang = sessionStorage.getItem(LANG_SESSION_KEY);
      if (sessionLang === 'en' || sessionLang === 'ko') return sessionLang;
    } catch {}
    return 'en'; // default on home page
  }

  function applyLang(lang) {
    activeLang = lang;
    // Always persist to sessionStorage so tag pages pick it up
    try { sessionStorage.setItem(LANG_SESSION_KEY, lang); } catch {}
    document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`.lang-btn[onclick*="${lang}"]`);
    if (btn) btn.classList.add('active');
    updatePostVisibility();
    renderHero();
  }

  // ── Tag links carry lang filter ───────────────────────────────────────────
  document.addEventListener('click', (e) => {
    const tagLink = e.target.closest('.tag-pill-sm');
    if (!tagLink) return;
    e.preventDefault();
    const href = tagLink.getAttribute('href') || '';
    if (activeLang === 'all') {
      window.location.href = href;
    } else {
      const sep = href.includes('?') ? '&' : '?';
      window.location.href = `${href}${sep}lang=${activeLang}`;
    }
  });

  document.addEventListener('previewModeChanged', () => updatePostVisibility());

  // Apply on load
  applyLang(getInitialLang());
</script>

<style>
  /* ── Hero h1 / p ── */
  .home-hero h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }
  .home-hero p {
    color: rgba(255,255,255,0.85);
    font-size: 1rem;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    margin: 0;
  }

  /* ── Hero carousel wrapper ── */
  .home-hero {
    position: relative;
    margin-bottom: 3rem;
    border-radius: 8px;
    background-color: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    text-align: center;
    overflow: hidden;
  }
  .hero-link {
    display: block;
    text-decoration: none;
    cursor: pointer;
    padding: 3rem 3.25rem 2.15rem;
    color: inherit;
    transition: opacity 0.2s;
  }
  .hero-link:hover {
    opacity: 0.92;
  }
  .hero-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.28);
    background: rgba(0,0,0,0.4);
    color: #fff;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s;
  }
  .hero-nav:hover {
    background: rgba(99,102,241,0.45);
    border-color: rgba(165,180,252,0.7);
  }
  .hero-nav-prev { left: 0.55rem; }
  .hero-nav-next { right: 0.55rem; }
  :global(.hero-dots) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    pointer-events: none;
  }
  :global(.hero-dot) {
    pointer-events: auto;
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    max-width: 8px;
    max-height: 8px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.25);
    cursor: pointer;
    font-size: 0;
    line-height: 0;
    flex: 0 0 8px;
    overflow: hidden;
  }
  :global(.hero-dot.is-active) {
    background: #fff;
    transform: scale(1.15);
  }
  .hero-signup {
    padding: 3rem 3.25rem 2.15rem;
  }
  .hero-signup-form { margin-top: 1.25rem; }

  /* ── Featured article strip at the bottom of the hero ── */
  .hero-featured {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.2);
  }
  .hero-featured-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent, #6366f1);
    background: rgba(99,102,241,0.18);
    border: 1px solid rgba(99,102,241,0.35);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hero-featured-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 520px;
  }

  /* ── Tag browse ── */
  .tag-browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }
  .tag-pill-sm {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    background: rgba(99, 102, 241, 0.06);
    color: var(--tag-text);
    border: 1px solid rgba(99, 102, 241, 0.15);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .tag-pill-sm:hover {
    background: rgba(99, 102, 241, 0.14);
    color: var(--tag-text-hover);
  }
  .tag-pill-sm.tag-hidden {
    display: none;
  }
  .tag-pill-sm.tag-hidden.tag-revealed {
    display: inline-block;
  }
  .tag-expand {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    background: transparent;
    color: var(--tag-strong-text);
    border: 1px dashed rgba(99, 102, 241, 0.35);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .tag-expand:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--tag-strong-hover);
    border-color: rgba(99, 102, 241, 0.55);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .home-hero h1 { font-size: 1.5rem; }
    .hero-featured-title { max-width: 180px; }
    .hero-nav { width: 2rem; height: 2rem; font-size: 1.2rem; }
  }
</style>

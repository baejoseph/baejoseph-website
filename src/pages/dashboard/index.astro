---
export const prerender = false;
import { getCollection } from 'astro:content';
import { isAdmin } from '../../lib/auth';
import { smtpConfigured } from '../../lib/email';

if (!isAdmin(Astro.request)) {
  return Astro.redirect('/dashboard/login');
}

const allPosts = await getCollection('blog');
const bySlug = new Map<string, typeof allPosts[0]>();
for (const p of allPosts) {
  bySlug.set(p.slug, p);
  if (p.data.wpSlug) bySlug.set(p.data.wpSlug, p);
}
const posts = allPosts
  .filter(p => (p.data.lang ?? 'en') !== 'ko')
  .map(p => {
    const ko = (p.data.pairedSlug ? bySlug.get(p.data.pairedSlug) : undefined)
      || allPosts.find(k => (k.data.lang ?? 'en') === 'ko' && k.data.pairedSlug === p.slug);
    return {
      slug: p.slug,
      title: p.data.title as string,
      date: p.data.date ?? '',
      lang: 'en',
      koSlug: ko?.slug ?? '',
      koTitle: (ko?.data.title as string) || '',
    };
  })
  .filter(p => p.koSlug)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const smtpOk = smtpConfigured();
const dbOk = Boolean(import.meta.env.DATABASE_URL || process.env.DATABASE_URL);
const adminEmail = import.meta.env.ADMIN_EMAIL || process.env.ADMIN_EMAIL || '';

function nextWeekday(from: Date, weekday: number) {
  const d = new Date(from);
  const add = (weekday + 7 - d.getUTCDay()) % 7 || 7;
  d.setUTCDate(d.getUTCDate() + add);
  return d.toISOString().slice(0, 10);
}
const today = new Date();
const nextTue = nextWeekday(today, 2);
const nextFri = nextWeekday(today, 5);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Dashboard — Joseph Bae</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    body { background: #0a0a0a; }
    .dash { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
    header.bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    header.bar h1 { font-size: 1.2rem; margin: 0; }
    .muted { color: var(--text-muted); font-size: 0.88rem; }
    .tabs { display: flex; gap: 0.35rem; flex-wrap: wrap; border-bottom: 1px solid #222; margin-bottom: 1.5rem; }
    .tab {
      background: none; border: 0; color: var(--text-muted); padding: 0.65rem 0.9rem;
      font-family: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer;
      border-bottom: 2px solid transparent; margin-bottom: -1px;
    }
    .tab.on { color: #fff; border-bottom-color: #6366f1; }
    .panel { display: none; }
    .panel.on { display: block; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
    @media (max-width: 800px) { .grid { grid-template-columns: 1fr 1fr; } }
    .stat { background: #111; border: 1px solid #222; border-radius: 10px; padding: 1rem 1.1rem; }
    .stat b { display: block; font-size: 1.5rem; margin-top: 0.2rem; }
    h2 { font-size: 1.05rem; margin: 1.5rem 0 0.75rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th, td { text-align: left; padding: 0.45rem 0.35rem; border-bottom: 1px solid #222; vertical-align: top; }
    th { color: var(--text-muted); font-weight: 500; }
    select, input, textarea {
      background: #111; color: var(--text); border: 1px solid #333; border-radius: 8px;
      padding: 0.5rem 0.65rem; font-family: inherit; font-size: 0.9rem; max-width: 100%;
    }
    textarea { width: 100%; min-height: 220px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; line-height: 1.45; }
    .row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem; }
    button, .btn {
      background: var(--accent); color: #fff; border: 0; border-radius: 8px; padding: 0.5rem 0.85rem;
      font-weight: 600; cursor: pointer; font-family: inherit; font-size: 0.85rem; text-decoration: none;
    }
    button.ghost, a.ghost { background: transparent; border: 1px solid #333; color: var(--text); }
    button.danger { background: transparent; border: 1px solid #7f1d1d; color: #fca5a5; }
    .ok { color: #86efac; } .bad { color: #fca5a5; }
    .pill { display: inline-block; font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.1rem 0.4rem; border-radius: 4px; border: 1px solid #333; color: #a5b4fc; }
    .qgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @media (max-width: 800px) { .qgrid { grid-template-columns: 1fr; } }
    .qcol { background: #111; border: 1px solid #222; border-radius: 12px; padding: 1rem; }
    .qcol h3 { margin: 0 0 0.75rem; font-size: 0.95rem; }
    .split { display: grid; grid-template-columns: 280px 1fr; gap: 1rem; min-height: 520px; }
    @media (max-width: 800px) { .split { grid-template-columns: 1fr; } }
    .elist { border: 1px solid #222; border-radius: 10px; overflow: auto; max-height: 70vh; }
    .eitem { display: block; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid #222; border-radius: 0; color: inherit; padding: 0.7rem 0.8rem; font-weight: 500; }
    .eitem.on { background: #19192a; }
    .eitem small { display: block; color: var(--text-muted); font-weight: 400; }
    iframe.prev { width: 100%; height: 420px; border: 1px solid #222; border-radius: 10px; background: #fff; }
    .note-box { display: none; margin: 0.75rem 0; position: relative; z-index: 5; }
    .note-box.show { display: block; }
    #e-note {
      display: block;
      width: 100%;
      min-height: 96px;
      font-family: Georgia, serif;
      font-size: 1rem;
      font-style: italic;
      line-height: 1.45;
      pointer-events: auto;
    }
    pre.help { white-space: pre-wrap; background: #111; border: 1px solid #222; border-radius: 10px; padding: 1rem; font-size: 0.8rem; line-height: 1.55; color: #c4c4c4; }
    details { margin-top: 1rem; }
    details summary { cursor: pointer; color: var(--text-muted); }
    .e-lang.on { background: #6366f1; border-color: #6366f1; color: #fff; }
  </style>
</head>
<body>
  <div class="dash">
    <header class="bar">
      <div>
        <h1>Newsletter</h1>
        <p class="muted">Tuesday archive · Friday new · you only</p>
      </div>
      <div class="row" style="margin:0">
        <a class="btn ghost" href="/">Blog</a>
        <button class="ghost" id="logout" type="button">Log out</button>
      </div>
    </header>

    <nav class="tabs" role="tablist">
      <button class="tab on" data-tab="summary" type="button">Summary</button>
      <button class="tab" data-tab="signups" type="button">Signups</button>
      <button class="tab" data-tab="queues" type="button">Queues</button>
      <button class="tab" data-tab="emails" type="button">Emails</button>
    </nav>

    <section class="panel on" id="panel-summary">
      <div class="grid">
        <div class="stat"><span class="muted">Active</span><b id="n-active">—</b></div>
        <div class="stat"><span class="muted">Unsubscribed</span><b id="n-left">—</b></div>
        <div class="stat"><span class="muted">Queued</span><b id="n-queued">—</b></div>
        <div class="stat"><span class="muted">Wiring</span>
          <div style="margin-top:0.45rem;font-size:0.85rem">
            DB: <span class={dbOk ? 'ok' : 'bad'}>{dbOk ? 'set' : 'missing'}</span><br />
            SMTP: <span class={smtpOk ? 'ok' : 'bad'}>{smtpOk ? 'set' : 'missing'}</span>
          </div>
        </div>
      </div>
      <h2>Signups by source</h2>
      <table>
        <thead><tr><th>Source</th><th>Count</th></tr></thead>
        <tbody id="src-body"><tr><td colspan="2" class="muted">Loading…</td></tr></tbody>
      </table>
      <h2>Upcoming</h2>
      <table>
        <thead><tr><th>Date</th><th>Slot</th><th>Post</th></tr></thead>
        <tbody id="up-body"><tr><td colspan="3" class="muted">Loading…</td></tr></tbody>
      </table>
      <details>
        <summary>Setup / Hostinger</summary>
        <div class="row" style="margin-top:0.75rem">
          <button type="button" id="setup-btn">Create / migrate tables</button>
          <span class="muted" id="setup-msg"></span>
        </div>
        <pre class="help">1. Neon DATABASE_URL in Vercel env
2. ADMIN_PASSWORD, ADMIN_SECRET, CRON_SECRET, SMTP_*
3. Hostinger mailbox newsletter@baejoseph.com + SPF/DKIM/DMARC
4. Click Create tables
Cron: Tue 08:00 UTC featured, Fri 08:00 UTC new.</pre>
      </details>
    </section>

    <section class="panel" id="panel-signups">
      <h2>By source</h2>
      <table>
        <thead><tr><th>Source</th><th>Count</th></tr></thead>
        <tbody id="src-body-2"><tr><td colspan="2" class="muted">Loading…</td></tr></tbody>
      </table>
      <h2>People</h2>
      <table>
        <thead><tr><th>Email</th><th>Lang</th><th>Signed up via</th><th>When</th></tr></thead>
        <tbody id="sub-body"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
      <h2>Recent events</h2>
      <table>
        <thead><tr><th>When</th><th>Email</th><th>Source</th><th>Path</th></tr></thead>
        <tbody id="ev-body"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </section>

    <section class="panel" id="panel-queues">
      <p class="muted" id="queue-msg"></p>
      <div class="qgrid">
        <div class="qcol">
          <h3>Tuesday · featured (archive) · EN+KO</h3>
          <div class="row">
            <input type="date" id="tue-date" value={nextTue} />
            <select id="tue-slug">
              {posts.map(p => (
                <option value={p.slug}>{p.date} · {p.title}{p.koTitle ? ` / ${p.koTitle}` : ''}</option>
              ))}
            </select>
            <button type="button" id="tue-btn">Queue</button>
          </div>
          <table>
            <thead><tr><th>Date</th><th>Post</th><th>Status</th><th></th></tr></thead>
            <tbody id="tue-body"></tbody>
          </table>
        </div>
        <div class="qcol">
          <h3>Friday · new · EN+KO</h3>
          <div class="row">
            <input type="date" id="fri-date" value={nextFri} />
            <select id="fri-slug">
              {posts.map(p => (
                <option value={p.slug}>{p.date} · {p.title}{p.koTitle ? ` / ${p.koTitle}` : ''}</option>
              ))}
            </select>
            <button type="button" id="fri-btn">Queue</button>
          </div>
          <table>
            <thead><tr><th>Date</th><th>Post</th><th>Status</th><th></th></tr></thead>
            <tbody id="fri-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="panel" id="panel-emails">
      <div class="split">
        <div class="elist" id="e-list"><div class="muted" style="padding:0.8rem">Loading…</div></div>
        <div>
          <p class="muted" id="e-empty">Loading the welcome letter…</p>
          <div id="e-editor" hidden>
            <div class="row">
              <span class="pill" id="e-meta"></span>
              <button type="button" class="ghost e-lang on" id="e-lang-en">English</button>
              <button type="button" class="ghost e-lang" id="e-lang-ko">한국어</button>
              <span class="muted" id="e-lang-hint"></span>
            </div>
            <div class="row">
              <button type="button" id="e-rebuild" class="ghost">Rebuild default</button>
              <button type="button" id="e-save">Save</button>
              <button type="button" id="e-send" class="ghost">Send now</button>
            </div>
            <div class="row">
              <input type="text" id="e-subject" style="flex:1;min-width:200px" placeholder="Subject" />
              <input type="email" id="e-test" placeholder="Test send to…" value={adminEmail} />
              <button type="button" id="e-test-btn" class="ghost">Test send</button>
            </div>
            <p class="muted" id="e-msg"></p>
            <div id="e-note-wrap" class="note-box">
              <label class="muted" for="e-note">Your note (top of the letter — EN and KO are separate)</label>
              <textarea id="e-note" rows="4" placeholder="A sentence or two — why this one, this week."></textarea>
            </div>
            <iframe class="prev" id="e-prev" title="Email preview" tabindex="-1"></iframe>
            <h2>HTML</h2>
            <textarea id="e-html"></textarea>
            <h2>Plain text</h2>
            <textarea id="e-text" style="min-height:120px"></textarea>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script define:vars={{ adminEmail }}>
    const tabs = [...document.querySelectorAll('.tab')];
    const panels = [...document.querySelectorAll('.panel')];
    function showTab(id) {
      tabs.forEach(t => t.classList.toggle('on', t.dataset.tab === id));
      panels.forEach(p => p.classList.toggle('on', p.id === 'panel-' + id));
      history.replaceState(null, '', '#' + id);
    }
    tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));
    const hash = (location.hash || '#summary').slice(1);
    if (['summary','signups','queues','emails'].includes(hash)) showTab(hash);

    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/dashboard/login';
    });

    document.getElementById('setup-btn')?.addEventListener('click', async () => {
      const msg = document.getElementById('setup-msg');
      const res = await fetch('/api/setup', { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (msg) msg.textContent = res.ok ? 'Tables ready.' : (data.error || 'Failed');
      if (res.ok) { loadStats(); loadQueue(); }
    });

    let queueItems = [];
    let welcomeTpl = null;
    let welcomeKo = null;
    let selectedId = 'welcome';
    let editorLang = 'en';

    function esc(s) {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
    }
    function slotLabel(s) { return s === 'friday_new' ? 'Friday new' : 'Tuesday featured'; }

    async function loadStats() {
      const res = await fetch('/api/stats');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        document.getElementById('n-active').textContent = '—';
        const err = `<tr><td colspan="4" class="muted">${esc(data.error || 'Database not ready. Open Summary → Create tables.')}</td></tr>`;
        document.getElementById('src-body').innerHTML = err;
        document.getElementById('src-body-2').innerHTML = err;
        document.getElementById('sub-body').innerHTML = err;
        document.getElementById('ev-body').innerHTML = err;
        return;
      }
      const subs = data.subscribers || [];
      const left = subs.filter(s => s.unsubscribed_at).length;
      document.getElementById('n-active').textContent = String(data.active ?? 0);
      document.getElementById('n-left').textContent = String(left);
      const srcRows = (data.sources || []).map(s => `<tr><td>${esc(s.source)}</td><td>${s.n}</td></tr>`).join('')
        || '<tr><td colspan="2" class="muted">None yet</td></tr>';
      document.getElementById('src-body').innerHTML = srcRows;
      document.getElementById('src-body-2').innerHTML = srcRows;
      document.getElementById('sub-body').innerHTML = subs.map(s => `<tr>
        <td>${esc(s.email)}${s.unsubscribed_at ? ' <span class="pill">left</span>' : ''}${s.suppressed_at ? ' <span class="pill">bounced</span>' : ''}${s.welcome_error ? ' <span class="pill">no welcome</span>' : ''}</td>
        <td>${esc(s.lang)}</td>
        <td>${esc(s.source)}</td>
        <td>${esc(String(s.created_at).slice(0, 16).replace('T',' '))}</td>
      </tr>`).join('') || '<tr><td colspan="4" class="muted">None yet</td></tr>';
      document.getElementById('ev-body').innerHTML = (data.events || []).map(e => `<tr>
        <td>${esc(String(e.created_at).slice(0, 16).replace('T',' '))}</td>
        <td>${esc(e.email)}</td>
        <td>${esc(e.source)}</td>
        <td>${esc(e.path || '')}</td>
      </tr>`).join('') || '<tr><td colspan="4" class="muted">None yet</td></tr>';
    }

    function queueRow(it) {
      const actions = it.status === 'queued'
        ? `<button class="ghost" data-open="${it.id}">Edit</button>
           <button class="ghost" data-send="${it.id}">Send</button>
           <button class="danger" data-del="${it.id}">Remove</button>`
        : `<button class="ghost" data-open="${it.id}">View</button>`;
      const pair = it.slug_ko ? `${esc(it.slug)} + ${esc(it.slug_ko)}` : esc(it.slug);
      const progress = it.status === 'queued' && it.error
        ? `<br /><small class="muted">${esc(it.error)}</small>`
        : '';
      return `<tr>
        <td>${esc(String(it.send_on).slice(0,10))}</td>
        <td>${pair}</td>
        <td><span class="pill">${esc(it.status)}</span>${it.html_ko ? ' <span class="pill">EN+KO</span>' : ''}${progress}</td>
        <td>${actions}</td>
      </tr>`;
    }

    async function loadQueue() {
      const res = await fetch('/api/queue');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err = `<tr><td colspan="4" class="muted">${esc(data.error || '—')}</td></tr>`;
        document.getElementById('tue-body').innerHTML = err;
        document.getElementById('fri-body').innerHTML = err;
        document.getElementById('up-body').innerHTML = err;
        return;
      }
      queueItems = data.items || [];
      const tue = queueItems.filter(i => i.slot === 'tuesday_featured');
      const fri = queueItems.filter(i => i.slot === 'friday_new');
      const queued = queueItems.filter(i => i.status === 'queued');
      document.getElementById('n-queued').textContent = String(queued.length);
      document.getElementById('tue-body').innerHTML = tue.map(queueRow).join('') || '<tr><td colspan="4" class="muted">Empty</td></tr>';
      document.getElementById('fri-body').innerHTML = fri.map(queueRow).join('') || '<tr><td colspan="4" class="muted">Empty</td></tr>';
      document.getElementById('up-body').innerHTML = queued.map(i => `<tr>
        <td>${esc(String(i.send_on).slice(0,10))}</td>
        <td>${slotLabel(i.slot)}</td>
        <td>${esc(i.slug)}</td>
      </tr>`).join('') || '<tr><td colspan="3" class="muted">Nothing queued</td></tr>';
      renderEmailList();
      bindQueueButtons();
      if (selectedId === 'welcome') selectWelcome();
    }

    function bindQueueButtons() {
      document.querySelectorAll('[data-del]').forEach(btn => {
        btn.addEventListener('click', async () => {
          await fetch('/api/queue?id=' + btn.getAttribute('data-del'), { method: 'DELETE' });
          loadQueue();
        });
      });
      document.querySelectorAll('[data-send]').forEach(btn => {
        btn.addEventListener('click', () => sendItem(Number(btn.getAttribute('data-send'))));
      });
      document.querySelectorAll('[data-open]').forEach(btn => {
        btn.addEventListener('click', () => {
          showTab('emails');
          selectEmail(Number(btn.getAttribute('data-open')));
        });
      });
    }

    async function queueSlot(slot, dateId, slugId) {
      const msg = document.getElementById('queue-msg');
      const res = await fetch('/api/queue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slot,
          send_on: document.getElementById(dateId).value,
          slug: document.getElementById(slugId).value,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (msg) msg.textContent = res.ok ? 'Queued EN + KO — open Emails to preview both.' : (data.error || 'Failed');
      if (res.ok) {
        await loadQueue();
        if (data.item?.id) {
          showTab('emails');
          selectEmail(data.item.id);
        }
      }
    }
    document.getElementById('tue-btn')?.addEventListener('click', () => queueSlot('tuesday_featured', 'tue-date', 'tue-slug'));
    document.getElementById('fri-btn')?.addEventListener('click', () => queueSlot('friday_new', 'fri-date', 'fri-slug'));

    async function loadTemplates() {
      const res = await fetch('/api/templates');
      const data = await res.json().catch(() => ({}));
      const tpls = data.templates || [];
      welcomeTpl = tpls.find(t => t.key === 'welcome') || null;
      welcomeKo = tpls.find(t => t.key === 'welcome_ko') || null;
      renderEmailList();
      if (selectedId === 'welcome') selectWelcome();
    }

    function renderEmailList() {
      const box = document.getElementById('e-list');
      const welcomeBtn = `<button type="button" class="eitem${selectedId==='welcome'?' on':''}" data-eid="welcome">
        ${esc((editorLang === 'ko' ? welcomeKo?.subject : welcomeTpl?.subject) || 'Welcome')}
        <small>Intro / welcome · EN + KO</small>
      </button>`;
      const rest = queueItems.map(it => `<button type="button" class="eitem${it.id===selectedId?' on':''}" data-eid="${it.id}">
        ${esc(it.subject || it.slug)}
        <small>${esc(String(it.send_on).slice(0,10))} · ${slotLabel(it.slot)} · ${esc(it.status)}</small>
      </button>`).join('');
      box.innerHTML = welcomeBtn + (rest || '<div class="muted" style="padding:0.8rem">No queued letters yet.</div>');
      box.querySelectorAll('[data-eid]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-eid');
          if (id === 'welcome') selectWelcome();
          else selectEmail(Number(id));
        });
      });
    }

    function fillEditor({ meta, subject, html, text, locked, rebuildLabel, showSend, showNote, note }) {
      const editor = document.getElementById('e-editor');
      const empty = document.getElementById('e-empty');
      empty.hidden = true;
      editor.hidden = false;
      document.getElementById('e-meta').textContent = meta;
      document.getElementById('e-subject').value = subject || '';
      document.getElementById('e-html').value = html || '';
      document.getElementById('e-text').value = text || '';
      document.getElementById('e-note').value = note || '';
      document.getElementById('e-note-wrap').classList.toggle('show', !!showNote);
      document.getElementById('e-note-wrap').hidden = false;
      document.getElementById('e-subject').disabled = locked;
      document.getElementById('e-html').disabled = locked;
      document.getElementById('e-text').disabled = locked;
      document.getElementById('e-note').disabled = false;
      document.getElementById('e-note').readOnly = false;
      document.getElementById('e-save').disabled = locked;
      document.getElementById('e-rebuild').disabled = locked;
      document.getElementById('e-rebuild').textContent = rebuildLabel;
      document.getElementById('e-send').hidden = !showSend;
      renderEmailList();
      refreshPreview();
    }

    function paintLangBtns() {
      document.getElementById('e-lang-en')?.classList.toggle('on', editorLang === 'en');
      document.getElementById('e-lang-ko')?.classList.toggle('on', editorLang === 'ko');
    }

    function stashEditor() {
      const f = {
        subject: document.getElementById('e-subject').value,
        html: document.getElementById('e-html').value,
        text_body: document.getElementById('e-text').value,
        note: document.getElementById('e-note').value,
      };
      if (selectedId === 'welcome') {
        if (editorLang === 'ko') welcomeKo = { ...(welcomeKo || {}), ...f, key: 'welcome_ko' };
        else welcomeTpl = { ...(welcomeTpl || {}), ...f, key: 'welcome' };
        return;
      }
      const it = queueItems.find(x => x.id === selectedId);
      if (!it) return;
      if (editorLang === 'ko') {
        it.subject_ko = f.subject; it.html_ko = f.html; it.text_body_ko = f.text_body; it.note_ko = f.note;
      } else {
        it.subject = f.subject; it.html = f.html; it.text_body = f.text_body; it.note = f.note;
      }
    }

    function fillFromLang() {
      paintLangBtns();
      const hint = document.getElementById('e-lang-hint');
      if (selectedId === 'welcome') {
        const t = editorLang === 'ko' ? welcomeKo : welcomeTpl;
        if (hint) hint.textContent = editorLang === 'ko' ? 'Sent to Korean signups' : 'Sent to English signups';
        fillEditor({
          meta: 'Welcome / intro · sent when someone subscribes',
          subject: t?.subject || '',
          html: t?.html || '',
          text: t?.text_body || '',
          locked: false,
          rebuildLabel: 'Reset to default',
          showSend: false,
          showNote: false,
          note: '',
        });
        return;
      }
      const it = queueItems.find(x => x.id === selectedId);
      if (!it) { selectWelcome(); return; }
      const hasKo = Boolean(it.html_ko || it.slug_ko);
      if (hint) {
        hint.textContent = editorLang === 'ko'
          ? (hasKo ? `KO · /${it.slug_ko}` : 'No Korean pair for this post')
          : `EN · /${it.slug}`;
      }
      fillEditor({
        meta: `${slotLabel(it.slot)} · ${String(it.send_on).slice(0,10)} · ${it.status}`,
        subject: (editorLang === 'ko' ? it.subject_ko : it.subject) || '',
        html: (editorLang === 'ko' ? it.html_ko : it.html) || '',
        text: (editorLang === 'ko' ? it.text_body_ko : it.text_body) || '',
        locked: it.status === 'sent' || it.status === 'failed',
        rebuildLabel: 'Rebuild from post',
        showSend: it.status === 'queued',
        showNote: it.slot === 'tuesday_featured' || it.slot === 'friday_new',
        note: (editorLang === 'ko' ? it.note_ko : it.note) || '',
      });
    }

    function selectWelcome() {
      selectedId = 'welcome';
      fillFromLang();
    }

    async function selectEmail(id) {
      selectedId = id;
      fillFromLang();
      const it = queueItems.find(x => x.id === id);
      if (!it || it.status === 'sent' || it.status === 'failed') return;
      const koHtml = String(it.html_ko || '');
      const emptyEn = !String(it.html || '').trim() || !String(it.subject || '').trim();
      // Fill in a letter that is missing (nothing to lose), or repair a Korean
      // letter built from the English body (no Hangul at all). A letter that has
      // content is never overwritten — that is what lost hand edits before.
      if (emptyEn || !koHtml || !/[\uac00-\ud7af]/.test(koHtml)) {
        const data = await patch(emptyEn ? 'rebuild' : 'rebuild-ko');
        if (data?.item) {
          queueItems = queueItems.map(x => x.id === data.item.id ? data.item : x);
          fillFromLang();
        }
      }
    }

    document.getElementById('e-lang-en')?.addEventListener('click', () => {
      stashEditor();
      editorLang = 'en';
      fillFromLang();
    });
    document.getElementById('e-lang-ko')?.addEventListener('click', () => {
      stashEditor();
      editorLang = 'ko';
      fillFromLang();
    });

    function applyNoteHtml(html, note) {
      const inner = String(note || '').trim()
        ? `<tr><td style="padding:0 0 22px 0;"><div style="font-size:17px;line-height:1.65;color:#e8e8e8;font-style:italic;border-left:3px solid #818cf8;padding:2px 0 2px 16px;">${esc(note.trim()).replace(/\n/g, '<br />')}</div></td></tr>`
        : '';
      const block = `<!--NOTE-->${inner}<!--/NOTE-->`;
      if (/<!--NOTE-->[\s\S]*?<!--\/NOTE-->/.test(html)) {
        return html.replace(/<!--NOTE-->[\s\S]*?<!--\/NOTE-->/, block);
      }
      const idx = html.indexOf('</tr>');
      if (idx === -1) return html;
      return html.slice(0, idx + 5) + block + html.slice(idx + 5);
    }
    function refreshPreview() {
      let html = document.getElementById('e-html').value;
      const noteEl = document.getElementById('e-note');
      const noteWrap = document.getElementById('e-note-wrap');
      if (noteWrap && noteWrap.classList.contains('show') && noteEl) {
        html = applyNoteHtml(html, noteEl.value);
      }
      const iframe = document.getElementById('e-prev');
      iframe.tabIndex = -1;
      iframe.srcdoc = html || '<p style="padding:1rem;font-family:sans-serif;color:#888">No HTML yet.</p>';
    }
    document.getElementById('e-html')?.addEventListener('input', refreshPreview);
    document.getElementById('e-note')?.addEventListener('keydown', (e) => {
      e.stopPropagation();
    });
    document.getElementById('e-note')?.addEventListener('blur', refreshPreview);

    async function patch(action, extra = {}) {
      const msg = document.getElementById('e-msg');
      const res = await fetch('/api/queue', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: selectedId, action, ...extra }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (msg) msg.textContent = data.error || 'Failed';
        return null;
      }
      if (msg) msg.textContent = action === 'save'
        ? 'Saved.'
        : action === 'rebuild-ko'
          ? 'Rebuilt the Korean letter from the post.'
          : action === 'rebuild'
            ? 'Rebuilt from the post.'
            : 'Sent.';
      return data;
    }

    document.getElementById('e-save')?.addEventListener('click', async () => {
      if (selectedId === 'welcome') {
        const key = editorLang === 'ko' ? 'welcome_ko' : 'welcome';
        const res = await fetch('/api/templates', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key,
            subject: document.getElementById('e-subject').value,
            html: document.getElementById('e-html').value,
            text: document.getElementById('e-text').value,
          }),
        });
        const data = await res.json().catch(() => ({}));
        const msg = document.getElementById('e-msg');
        if (!res.ok) { if (msg) msg.textContent = data.error || 'Failed'; return; }
        if (editorLang === 'ko') welcomeKo = data.template;
        else welcomeTpl = data.template;
        if (msg) msg.textContent = editorLang === 'ko' ? '한국어 환영 메일 저장.' : 'Welcome letter saved.';
        selectWelcome();
        return;
      }
      const data = await patch('save', {
        lang: editorLang,
        subject: document.getElementById('e-subject').value,
        html: document.getElementById('e-html').value,
        text: document.getElementById('e-text').value,
        note: document.getElementById('e-note-wrap').hidden ? undefined : document.getElementById('e-note').value,
      });
      if (data?.item) {
        queueItems = queueItems.map(x => x.id === data.item.id ? data.item : x);
        selectEmail(data.item.id);
      }
    });
    document.getElementById('e-rebuild')?.addEventListener('click', async () => {
      if (selectedId === 'welcome') {
        const res = await fetch('/api/templates', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: editorLang === 'ko' ? 'welcome_ko' : 'welcome', action: 'rebuild' }),
        });
        const data = await res.json().catch(() => ({}));
        if (data?.template) {
          if (editorLang === 'ko') welcomeKo = data.template;
          else welcomeTpl = data.template;
          document.getElementById('e-msg').textContent = 'Reset to the default welcome letter.';
          selectWelcome();
        }
        return;
      }
      const data = await patch('rebuild');
      if (data?.item) {
        queueItems = queueItems.map(x => x.id === data.item.id ? data.item : x);
        selectEmail(data.item.id);
      }
    });
    document.getElementById('e-send')?.addEventListener('click', () => {
      if (selectedId && selectedId !== 'welcome') sendItem(selectedId);
    });
    document.getElementById('e-test-btn')?.addEventListener('click', async () => {
      const to = document.getElementById('e-test').value;
      if (!to) return;
      const msg = document.getElementById('e-msg');
      if (selectedId === 'welcome') {
        const res = await fetch('/api/templates', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: editorLang === 'ko' ? 'welcome_ko' : 'welcome', action: 'test', testTo: to }),
        });
        const data = await res.json().catch(() => ({}));
        if (msg) msg.textContent = res.ok ? `Test sent to ${to}.` : (data.error || 'Failed');
        return;
      }
      const data = await patch('send-now', { testTo: to, lang: editorLang });
      if (data && msg) msg.textContent = `Test sent to ${to}.`;
    });

    async function sendItem(id) {
      const msg = document.getElementById('queue-msg');
      const res = await fetch('/api/queue', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, action: 'send-now' }),
      });
      const data = await res.json().catch(() => ({}));
      const r = data.result || {};
      const text = res.ok
        ? `Sent ${r.sent ?? 0}, failed ${r.failed ?? 0}${r.remaining ? `, ${r.remaining} still to send — press Send again` : ''}`
        : (data.error || 'Send failed');
      if (msg) msg.textContent = text;
      const em = document.getElementById('e-msg');
      if (em) em.textContent = text;
      loadQueue();
    }

    loadStats();
    loadQueue();
    loadTemplates();
  </script>
</body>
</html>
